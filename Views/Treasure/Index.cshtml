@using System.IO
@{
    ViewData["Title"] = "Stange Treasure";
    string pathAtual = ViewBag.CaminhoAtual;
    string pathPai = ViewBag.CaminhoPai;
    List<string> todasPastas = ViewBag.TodasPastas;
    int objIndex = 0; // Usado para gerar IDs seguros e únicos no Javascript
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1 class="glow" style="color: var(--roxo-neon); margin: 0;">[ STANGE TREASURE ]</h1>
    <div>
        <a asp-action="FazerBackup" class="btn pulse" style="color: var(--ciano); border-color: var(--ciano); margin:0; margin-right: 10px;">[ GERAR BACKUP (.ZIP) ]</a>
        <a asp-controller="Trono" asp-action="Index" class="btn" style="color: var(--vinho); border-color: var(--vinho); margin:0;">[ VOLTAR AO TRONO ]</a>
    </div>
</div>

@if (ViewBag.Erro != null)
{
    <p style="color: var(--vinho); font-weight: bold; padding: 10px; border: 1px solid var(--vinho); background: rgba(122,8,49,0.2);">
        [!] @ViewBag.Erro
    </p>
}

<div style="background-color: var(--preto); border: 1px solid var(--ciano-escuro); padding: 10px; margin-bottom: 20px;">
    <span style="color: var(--lilas);">Caminho:</span> 
    <span style="color: var(--ciano);">root / @(string.IsNullOrEmpty(pathAtual) ? "" : pathAtual.Replace("\\", " / "))</span>
</div>

<div class="trono-grid" style="margin-bottom: 20px;">
    <div class="trono-panel" style="padding: 15px;">
        <h4 style="color: var(--offwhite); margin-top:0;">> Criar Diretório Aqui</h4>
        <form asp-action="CriarPasta" method="post" style="display: flex; gap: 10px;">
            <input type="hidden" name="pathAtual" value="@pathAtual" />
            <input type="text" name="nomePasta" class="input-terminal" style="margin:0; padding:5px; flex-grow:1;" placeholder="Nome da pasta..." required />
            <button type="submit" class="btn" style="margin:0; border-color: var(--ciano);">[CRIAR]</button>
        </form>
    </div>

    <div class="trono-panel" style="padding: 15px;">
        <h4 style="color: var(--offwhite); margin-top:0;">> Injetar Dados</h4>
        
        <form id="formUpload" enctype="multipart/form-data" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <input type="hidden" name="pathAtual" value="@pathAtual" />
            
            <input type="file" id="uploadFiles" name="arquivosUpload" class="input-terminal" style="margin:0; padding:2px; flex-grow:1; width: 100px;" multiple title="Selecionar Ficheiros" />
            <input type="file" id="uploadDir" name="arquivosUpload" class="input-terminal" style="margin:0; padding:2px; flex-grow:1; width: 100px; border-color: var(--lilas);" webkitdirectory directory multiple title="Selecionar uma Pasta Inteira" />
            
            <span style="color: var(--lilas);">Para:</span>
            <select name="destinoUpload" class="input-terminal" style="margin:0; padding:2px; height: 32px; border-color: var(--roxo-neon);">
                @foreach (var p in todasPastas)
                {
                    string displayPath = p == "" ? "/ (Raiz)" : "/" + p.Replace("\\", "/");
                    if (p == pathAtual) { <option value="@p" selected>@displayPath</option> }
                    else { <option value="@p">@displayPath</option> }
                }
            </select>

            <button type="button" onclick="iniciarUpload()" class="btn pulse" style="margin:0; border-color: var(--roxo-neon); color: var(--roxo-neon);">[ UPLOAD ]</button>
        </form>

        <div id="progressContainer" style="display: none; width: 100%; margin-top: 15px; background-color: rgba(0,0,0,0.5); border: 1px solid var(--roxo-neon); height: 18px; position: relative;">
            <div id="progressBar" style="width: 0%; background-color: var(--roxo-neon); height: 100%; transition: width 0.1s;"></div>
            <span id="progressText" style="position: absolute; width: 100%; text-align: center; color: var(--offwhite); font-weight: bold; font-size: 0.8rem; top: 0; text-shadow: 1px 1px 2px var(--preto);">0%</span>
        </div>

    </div>
</div>

<form asp-action="BaixarLote" method="post" id="formLote">
    <input type="hidden" name="pathAtual" value="@pathAtual" />
    
    <div class="trono-panel trono-full-width" style="overflow-x: auto;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--vinho-escuro); padding-bottom: 10px; margin-bottom: 10px;">
            <span style="color: var(--lilas); font-weight: bold;">CONTEÚDO DO DIRETÓRIO</span>
            <button type="submit" class="btn pulse" style="margin: 0; padding: 5px 15px; color: var(--ciano); border-color: var(--ciano);">
                [ DESCARREGAR SELECIONADOS (.ZIP) ]
            </button>
        </div>

        <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 800px;">
            <thead>
                <tr style="color: var(--ciano-escuro);">
                    <th style="width: 40px; text-align: center;"><input type="checkbox" id="checkAll" style="cursor: pointer;"></th>
                    <th style="padding: 10px;">Tipo</th>
                    <th style="padding: 10px;">Nome do Item</th>
                    <th style="padding: 10px; text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (pathAtual != "")
                {
                    <tr style="border-bottom: 1px dashed var(--ciano-escuro);">
                        <td></td>
                        <td style="padding: 10px; text-align: center; font-size: 1.5rem;">🔙</td>
                        <td colspan="2" style="padding: 10px;">
                            <a asp-action="Index" asp-route-path="@pathPai" style="color: var(--ciano); font-weight: bold; font-size: 1.1rem;">[ Retornar ao Nível Superior ]</a>
                        </td>
                    </tr>
                }

                @foreach (var pasta in ViewBag.Pastas)
                {
                    objIndex++;
                    <tr style="border-bottom: 1px dashed var(--ciano-escuro);">
                        <td style="text-align: center;"><input type="checkbox" name="itensSelecionados" value="@pasta" style="cursor: pointer;"></td>
                        <td style="padding: 10px; text-align: center; font-size: 1.5rem;">📁</td>
                        <td style="padding: 10px;">
                            <a asp-action="Index" asp-route-path="@System.IO.Path.Combine(pathAtual, pasta)" style="color: var(--roxo-neon); text-decoration: underline; font-weight: bold;">@pasta</a>
                        </td>
                        <td style="padding: 10px; text-align: right; display: flex; justify-content: flex-end; gap: 10px; align-items: center; flex-wrap: wrap;">
                            
                            <select id="sel_move_@objIndex" class="input-terminal" style="margin:0; padding:0 5px; height: 22px; font-size: 0.8rem; border-color: var(--lilas);">
                                @foreach (var p in todasPastas)
                                {
                                    string displayPath = p == "" ? "/" : "/" + p.Replace("\\", "/");
                                    <option value="@p">@displayPath</option>
                                }
                            </select>
                            <button type="button" onclick="submitMove('@pasta', 'sel_move_@objIndex')" style="background: none; border: 1px solid var(--lilas); color: var(--lilas); cursor: pointer; padding: 2px 5px;">[ MOVER ]</button>

                            <button type="button" onclick="confirmDelete('@pasta', true)" style="background: none; border: 1px solid var(--vinho); color: var(--vinho); cursor: pointer; padding: 2px 5px;">[ DELETAR ]</button>
                        </td>
                    </tr>
                }

                @foreach (var arquivo in ViewBag.Arquivos)
                {
                    objIndex++;
                    string ext = System.IO.Path.GetExtension(arquivo).ToLower();
                    bool isImagem = ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".webp";
                    bool isTexto = ext == ".txt" || ext == ".md" || ext == ".html" || ext == ".json";
                    bool isPdf = ext == ".pdf";
                    bool isAudio = ext == ".mp3" || ext == ".wav" || ext == ".ogg";
                    bool isVideo = ext == ".mp4" || ext == ".mkv" || ext == ".webm";

                    string icone = "📄";
                    if (isImagem) icone = "🖼️";
                    if (isPdf) icone = "📕";
                    if (isAudio) icone = "🎵";
                    if (isVideo) icone = "🎥";
                    if (ext == ".zip" || ext == ".rar") icone = "📦";

                    <tr style="border-bottom: 1px dashed var(--ciano-escuro);">
                        <td style="text-align: center;"><input type="checkbox" name="itensSelecionados" value="@arquivo" style="cursor: pointer;"></td>
                        <td style="padding: 10px; text-align: center; font-size: 1.5rem;">@icone</td>
                        <td style="padding: 10px; color: var(--offwhite);">@arquivo</td>
                        <td style="padding: 10px; text-align: right; display: flex; justify-content: flex-end; gap: 10px; align-items: center; flex-wrap: wrap;">
                            
                            <select id="sel_move_@objIndex" class="input-terminal" style="margin:0; padding:0 5px; height: 22px; font-size: 0.8rem; border-color: var(--lilas);">
                                @foreach (var p in todasPastas)
                                {
                                    string displayPath = p == "" ? "/" : "/" + p.Replace("\\", "/");
                                    <option value="@p">@displayPath</option>
                                }
                            </select>
                            <button type="button" onclick="submitMove('@arquivo', 'sel_move_@objIndex')" style="background: none; border: 1px solid var(--lilas); color: var(--lilas); cursor: pointer; padding: 2px 5px;">[ MOVER ]</button>

                            @if (isImagem) { <a target="_blank" href="@Url.Action("ServirArquivo", new { pathAtual = pathAtual, nomeArquivo = arquivo, download = false })" style="color: var(--ciano);">[ VER ]</a> }
                            @if (isTexto) { <a asp-action="Editar" asp-route-pathAtual="@pathAtual" asp-route-nomeArquivo="@arquivo" style="color: var(--lilas);">[ EDITAR ]</a> }
                            
                            <a href="@Url.Action("ServirArquivo", new { pathAtual = pathAtual, nomeArquivo = arquivo, download = true })" style="color: var(--offwhite);">[ DOWN ]</a>
                            <button type="button" onclick="confirmDelete('@arquivo', false)" style="background: none; border: 1px solid var(--vinho); color: var(--vinho); cursor: pointer; padding: 2px 5px;">[ DELETAR ]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (ViewBag.Pastas.Count == 0 && ViewBag.Arquivos.Count == 0)
        {
            <p style="text-align: center; color: var(--vinho-escuro); margin-top: 20px;">O vácuo domina este espaço.</p>
        }
    </div>
</form>

<form id="formDelete" asp-action="Deletar" method="post" style="display: none;">
    <input type="hidden" name="pathAtual" value="@pathAtual" />
    <input type="hidden" name="nomeItem" id="deleteNomeItem" />
    <input type="hidden" name="isPasta" id="deleteIsPasta" />
</form>

<form id="formMove" asp-action="Mover" method="post" style="display: none;">
    <input type="hidden" name="pathAtual" value="@pathAtual" />
    <input type="hidden" name="nomeItem" id="moveNomeItem" />
    <input type="hidden" name="destinoItem" id="moveDestinoItem" />
</form>

<script>
    // 1. Checkboxes em massa
    document.getElementById('checkAll').addEventListener('change', function() {
        const checkboxes = document.querySelectorAll('input[name="itensSelecionados"]');
        checkboxes.forEach(cb => cb.checked = this.checked);
    });

    // 2. Dispara a deleção via form oculto
    function confirmDelete(nome, isPasta) {
        if (confirm(`Aviso de Sistema: Deseja realmente obliterar [ ${nome} ] do servidor?`)) {
            document.getElementById('deleteNomeItem').value = nome;
            document.getElementById('deleteIsPasta').value = isPasta ? "true" : "false";
            document.getElementById('formDelete').submit();
        }
    }

    // 3. Dispara o movimento via form oculto
    function submitMove(nomeItem, selectId) {
        const destino = document.getElementById(selectId).value;
        document.getElementById('moveNomeItem').value = nomeItem;
        document.getElementById('moveDestinoItem').value = destino;
        document.getElementById('formMove').submit();
    }

// 4. Mágica do Upload Sequencial com Barra de Progresso
    async function iniciarUpload() {
        const files1 = Array.from(document.getElementById('uploadFiles').files);
        const files2 = Array.from(document.getElementById('uploadDir').files);
        const allFiles = [...files1, ...files2]; // Junta arquivos soltos e pastas

        if(allFiles.length === 0) {
            alert('Selecione os ficheiros ou a pasta para injetar no cofre.');
            return;
        }

        // Mostra a barra de progresso
        document.getElementById('progressContainer').style.display = 'block';
        const progressBar = document.getElementById('progressBar');
        const progressText = document.getElementById('progressText');

        // Pega os destinos
        const pathAtual = document.querySelector('input[name="pathAtual"]').value;
        const destino = document.querySelector('select[name="destinoUpload"]').value;

        let totalEnviado = 0;
        const totalArquivos = allFiles.length;

        // Inicia o Loop de Envio (Um por Um)
        for (let i = 0; i < totalArquivos; i++) {
            const file = allFiles[i];
            
            // Atualiza o texto para mostrar qual arquivo está subindo agora
            progressText.innerText = `Injetando: ${file.name} [ ${i + 1} / ${totalArquivos} ]`;

            const formData = new FormData();
            formData.append('pathAtual', pathAtual);
            formData.append('destinoUpload', destino);
            formData.append('arquivosUpload', file);

            try {
                // Dispara o arquivo e espera a resposta
                const response = await fetch('@Url.Action("Upload", "Treasure")', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    totalEnviado++;
                    // Atualiza a barra de progresso baseada na quantidade de arquivos
                    const percentComplete = Math.round((totalEnviado / totalArquivos) * 100);
                    progressBar.style.width = percentComplete + '%';
                } else {
                    console.error("Falha ao subir o arquivo: " + file.name);
                }
            } catch (e) {
                console.error("Erro de conexão no arquivo: " + file.name);
            }
        }

        // Finalização
        progressText.innerText = '100% [Transferência Concluída! Recarregando...]';
        progressBar.style.backgroundColor = "var(--ciano)";
        
        // Aguarda 1 segundo para você ver o 100% e recarrega a página
        setTimeout(() => window.location.reload(), 1000);
    }
</script>