@{
    ViewData["Title"] = "Editor Real - " + ViewBag.NomeArquivo;
    Layout = null; // Removemos o layout padrão para o editor ocupar 100% da tela

// O truque de gênio: Usamos a rede interna do Docker para a comunicação!
    string internalUrl = $"https://www.stangecastle.com.br/Office/Download?pathAtual={ViewBag.PathAtual}&nomeArquivo={ViewBag.NomeArquivo}";
    string callbackUrl = $"https://www.stangecastle.com.br/Office/Callback?pathAtual={ViewBag.PathAtual}&nomeArquivo={ViewBag.NomeArquivo}";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <style>
        html, body { height: 100%; margin: 0; padding: 0; background-color: #1a1a1a; overflow: hidden; }
        .top-bar { background: #000; padding: 10px; border-bottom: 2px solid #3DF2FF; display: flex; justify-content: space-between; }
        .btn { background: none; color: #3DF2FF; border: 1px solid #3DF2FF; padding: 5px 10px; cursor: pointer; text-decoration: none; font-family: monospace; }
        .btn:hover { background: rgba(61, 242, 255, 0.2); }
    </style>
</head>
<body>

    <div class="top-bar">
        <span style="color: #A33BFF; font-family: monospace; font-weight: bold;">[ ONLYOFFICE_INTEGRATION ] :: @ViewBag.NomeArquivo</span>
        <a href="/Treasure/Index?path=@ViewBag.PathAtual" class="btn">[ <- VOLTAR AO COFRE ]</a>
    </div>

    <div id="placeholder" style="height: calc(100% - 15px);"></div>

    <script src="https://docs.stangecastle.com.br/web-apps/apps/api/documents/api.js"></script>
    
    <script>
        var docEditor = new DocsAPI.DocEditor("placeholder", {
            "document": {
                "fileType": "@ViewBag.Extensao",
                "key": "@ViewBag.DocumentKey",
                "title": "@ViewBag.NomeArquivo",
                "url": "@Html.Raw(internalUrl)", 
                "permissions": {
                    "edit": true,
                    "download": true
                }
            },
            "documentType": "@ViewBag.DocumentType",
            "editorConfig": {
                "mode": "edit",
                "lang": "pt-BR",
                "callbackUrl": "@Html.Raw(callbackUrl)",
                "user": {
                    "id": "admin_stange",
                    "name": "Mestre Stange"
                }
            }
        });
    </script>
</body>
</html>