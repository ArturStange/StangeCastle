@{
    ViewData["Title"] = "Editor Real - " + ViewBag.NomeArquivo;
    Layout = null; // Removemos o layout padrão para o editor ocupar 100% da tela[cite: 19]

    // FORMATAMOS OS NOMES PARA NÃO QUEBRAREM OS LINKS SE TIVEREM ESPAÇOS OU ACENTOS
    string pathSeguro = Uri.EscapeDataString(ViewBag.PathAtual ?? "");
    string nomeSeguro = Uri.EscapeDataString(ViewBag.NomeArquivo ?? "");

    // O TRUQUE DE MESTRE: Usamos o nome do contentor Docker e a porta interna!
    string internalUrl = $"http://stange_castle_app:4233/Office/Download?pathAtual={pathSeguro}&nomeArquivo={nomeSeguro}";
    string callbackUrl = $"http://stange_castle_app:4233/Office/Callback?pathAtual={pathSeguro}&nomeArquivo={nomeSeguro}";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Pergaminhos"]</title>
<style>
        /* Removemos todas as margens para o editor ocupar o ecrã inteiro */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #f4f4f4;
        }
        #placeholder {
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body>

    <!-- O espaço vazio que o OnlyOffice vai preencher -->
    <div id="placeholder"></div>

    <script src="https://docs.stangecastle.com.br/web-apps/apps/api/documents/api.js"></script>
    
    <script>
        var docEditor = new DocsAPI.DocEditor("placeholder", {
            "document": {
                "fileType": "@ViewBag.Extensao",
                "key": "@ViewBag.DocumentKey",
                "title": "@ViewBag.NomeArquivo",
                "url": "@Html.Raw(internalUrl)", 
                "permissions": {
                    "edit": @ViewBag.PodeEditar.ToString().ToLower(),
                    "download": true
                }
            },
            "documentType": "@ViewBag.DocumentType",
            "editorConfig": {
                // "edit" ou "view" dependendo da autorização
                "mode": "@ViewBag.ModoOffice",
                "lang": "pt-BR",
                "callbackUrl": "@Html.Raw(callbackUrl)",
                "user": {
                    // O nome da pessoa no Google Auth aparecerá no cursor
                    "name": "@ViewBag.UserName"
                }
            }
        });
    </script>
</body>
</html>